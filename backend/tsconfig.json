{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		/* imports with @ */
		"paths": {
			"@/*": ["./src/*"],
			"@/shared/*": ["../shared/*"]
		},
		"rootDirs": [".", "../shared/"],
		"rootDir": "..",
		"outDir": "./dist",
		"skipLibCheck": true,
		"strictNullChecks": true,
		"strict": true
	},
	"include": ["src", "../shared"]
}
